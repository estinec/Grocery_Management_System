@model IEnumerable<Grocery_Management.Models.Purchase>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">📊 Admin &amp; Manager Dashboard</h2>
        <p class="text-muted mb-0">Store performance overview, inventory alerts, and staff controls.</p>
    </div>
    <div>
        <a asp-action="CreateProduct" class="btn btn-success me-2">+ Add Product</a>
        <a asp-action="CreateAssociate" class="btn btn-outline-dark">+ Provision Associate</a>
    </div>
</div>

<!-- KPI Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100 bg-success text-white">
            <div class="card-body">
                <h6 class="text-uppercase opacity-75">Total Revenue</h6>
                <h2 class="fw-bold mb-0">$@(((decimal)ViewBag.TotalRevenue).ToString("N2"))</h2>
                <small>@ViewBag.TotalOrders completed orders</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-uppercase text-muted">Catalog Size</h6>
                <h2 class="fw-bold mb-0">@ViewBag.TotalProducts</h2>
                <small class="text-muted">Active grocery items</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100 @(ViewBag.LowStockCount > 0 ? "border-start border-danger border-4" : "")">
            <div class="card-body">
                <h6 class="text-uppercase text-muted">Low Stock Alerts</h6>
                <h2 class="fw-bold text-danger mb-0">@ViewBag.LowStockCount</h2>
                <small class="text-muted">Items with 10 or fewer units</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-uppercase text-muted">Store Associates</h6>
                <h2 class="fw-bold mb-0">@ViewBag.AssociateCount</h2>
                <small class="text-muted">Active cashier accounts</small>
            </div>
        </div>
    </div>
</div>

<!-- Quick Management Modules -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h5 class="card-title fw-bold">📦 Inventory &amp; Stock</h5>
                    <p class="card-text text-muted small">Monitor stock levels, add new emoji-tagged items, and restock low-inventory shelves.</p>
                </div>
                <a asp-action="StockOverview" class="btn btn-primary w-100 mt-3">Manage Inventory</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h5 class="card-title fw-bold">🧾 Sales &amp; Audit History</h5>
                    <p class="card-text text-muted small">Inspect itemized receipts across both in-store Associate POS checkouts and online Customer orders.</p>
                </div>
                <a asp-action="PurchaseHistory" class="btn btn-primary w-100 mt-3">View All Receipts</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h5 class="card-title fw-bold">👥 Staff &amp; Associates</h5>
                    <p class="card-text text-muted small">View active store associates and provision new cashier credentials for POS access.</p>
                </div>
                <a asp-action="ManageEmployees" class="btn btn-primary w-100 mt-3">Manage Associates</a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Activity Feed -->
<div class="card shadow-sm">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <span class="fw-bold">Recent Transactions</span>
        <a asp-action="PurchaseHistory" class="btn btn-sm btn-outline-light">Full History</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Receipt #</th>
                    <th>Date (UTC)</th>
                    <th>Source / Cashier</th>
                    <th>Items</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No transactions recorded yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@order.Id</td>
                            <td>@order.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><span class="badge bg-secondary">@order.AssociateId</span></td>
                            <td>@order.Items.Sum(i => i.Quantity) unit(s)</td>
                            <td class="text-end fw-bold text-success">$@order.TotalPrice.ToString("N2")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>