@model IEnumerable<Grocery_Management.Models.ApplicationUser>
@{
    ViewData["Title"] = "Manage Associates";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Store Associates &amp; Staff</h2>
    <a asp-action="CreateAssociate" class="btn btn-success">+ Provision New Associate</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
    <tr>
        <th>Full Name</th>
        <th>Email / Username</th>
        <th>Account Created (UTC)</th>
    </tr>
    </thead>
    <tbody>
    @if (!Model.Any())
    {
        <tr>
            <td colspan="3" class="text-center text-muted py-4">No associate accounts found. Provision one above.</td>
        </tr>
    }
    else
    {
        @foreach (var emp in Model)
        {
            <tr>
                <td class="fw-bold">@emp.FullName</td>
                <td>@emp.Email</td>
                <td>@emp.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
            </tr>
        }
    }
    </tbody>
</table>