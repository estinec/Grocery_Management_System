@model IEnumerable<Grocery_Management.Models.Purchase>

@{
    ViewData["Title"] = "Purchase History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Purchase History & Audit Log</h2>
    <a asp-controller="Admin" asp-action="StockOverview" class="btn btn-outline-secondary btn-sm">&larr; Back to Inventory</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        No purchases have been recorded yet. Head over to the <a asp-controller="Associate" asp-action="CreatePurchase" class="alert-link">Associate Portal</a> to log a sale.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered shadow-sm align-middle">
            <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Product Name</th>
                <th>Quantity Purchased</th>
                <th>Total Price</th>
                <th>Associate ID</th>
                <th>Date & Time (UTC)</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var purchase in Model)
            {
                <tr>
                    <td>#@purchase.Id</td>
                    <td class="fw-bold">@purchase.Product?.Name</td>
                    <td><span class="badge bg-secondary">@purchase.Quantity</span></td>
                    <td class="text-success fw-bold">$@purchase.TotalPrice.ToString("F2")</td>
                    <td><code>@purchase.AssociateId</code></td>
                    <td>@purchase.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}