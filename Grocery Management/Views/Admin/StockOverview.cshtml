@model IEnumerable<Grocery_Management.Models.Product>
@{
    ViewData["Title"] = "Inventory Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Inventory Management</h2>
    <div>
        <a asp-action="PurchaseHistory" class="btn btn-outline-secondary me-2">Purchase History</a>
        <a asp-action="CreateProduct" class="btn btn-success">+ Add New Product</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<table class="table table-striped table-bordered mt-3 align-middle">
    <thead>
    <tr>
        <th>Product Name</th>
        <th>Category</th>
        <th>Unit Price</th>
        <th>In Stock</th>
        <th>Receive Shipping</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Category?.Name</td>
            <td>$@item.UnitPrice.ToString("F2")</td>
            <td><span class="badge @(item.CurrentStock < 10 ? "bg-danger" : "bg-success")">@item.CurrentStock</span></td>
            <td>
                <form asp-action="Restock" method="post" class="d-flex">
                    <input type="hidden" name="productId" value="@item.Id" />
                    <input type="number" name="additionalStock" min="1" class="form-control form-control-sm me-2" placeholder="Qty" required />
                    <button type="submit" class="btn btn-sm btn-outline-success">Add Stock</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>