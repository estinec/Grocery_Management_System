@model IEnumerable<Grocery_Management.Models.Product>
@{
    ViewData["Title"] = "Grocery Storefront";
    var categories = ViewBag.Categories as List<Grocery_Management.Models.Category> ?? new();
    var selectedCat = ViewBag.SelectedCategory as int?;
}

<div class="row mb-4 align-items-center">
    <div class="col-md-6">
        <h2>🛍️ Online Grocery Store</h2>
        <p class="text-muted">Browse fresh produce, bakery items, and pantry essentials.</p>
    </div>
    <div class="col-md-6 text-md-end">
        <a asp-action="Cart" class="btn btn-outline-primary position-relative">
            🛒 View Shopping Cart
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Category Filter Pills -->
<div class="mb-4">
    <a asp-action="Index" class="btn @(selectedCat == null ? "btn-dark" : "btn-outline-dark") btn-sm me-2 mb-2">All Products</a>
    @foreach (var cat in categories)
    {
        <a asp-action="Index" asp-route-categoryId="@cat.Id" class="btn @(selectedCat == cat.Id ? "btn-dark" : "btn-outline-dark") btn-sm me-2 mb-2">@cat.Name</a>
    }
</div>

<!-- Product Grid -->
<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
    @foreach (var p in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm text-center p-3">
                <div class="display-3 my-2">@p.Emoji</div>
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <span class="badge bg-secondary mb-2">@p.Category?.Name</span>
                        <h5 class="card-title fw-bold">@p.Name</h5>
                        <p class="text-success fw-bold fs-5 mb-1">$@p.UnitPrice.ToString("0.00")</p>
                        <p class="text-muted small">In Stock: @p.CurrentStock</p>
                    </div>

                    @if (p.CurrentStock > 0)
                    {
                        <form asp-action="AddToCart" method="post" class="mt-3">
                            <input type="hidden" name="productId" value="@p.Id" />
                            <div class="input-group input-group-sm mb-2">
                                <input type="number" name="quantity" value="1" min="1" max="@p.CurrentStock" class="form-control text-center" />
                                <button type="submit" class="btn btn-success">Add to Cart</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-sm w-100" disabled>Out of Stock</button>
                    }
                </div>
            </div>
        </div>
    }
</div>