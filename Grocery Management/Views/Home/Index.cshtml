@{
    ViewData["Title"] = "Welcome to FreshMarket";
}

<div class="p-5 mb-4 bg-light rounded-3 shadow-sm text-center">
    <div class="container-fluid py-5">
        <h1 class="display-4 fw-bold">🛒 Welcome to FreshMarket Grocery</h1>
        <p class="col-md-8 fs-4 mx-auto text-muted">Your neighborhood destination for fresh produce, artisan bakery items, dairy, and pantry essentials.</p>
        <div class="mt-4">
            <a asp-controller="Customer" asp-action="Index" class="btn btn-success btn-lg px-4 me-2 shadow-sm">🛍️ Browse Storefront</a>
            @if (!User.Identity?.IsAuthenticated ?? true)
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg px-4">Sign In</a>
            }
        </div>
    </div>
</div>

<div class="row text-center g-4 mt-2">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm p-3 border-0">
            <div class="fs-1 mb-2">🍎</div>
            <h3 class="fw-bold">Fresh Produce</h3>
            <p class="text-muted">Hand-picked fruits and crisp vegetables delivered fresh daily.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm p-3 border-0">
            <div class="fs-1 mb-2">🥐</div>
            <h3 class="fw-bold">Bakery &amp; Treats</h3>
            <p class="text-muted">Warm, delicious artisan breads, croissants, and baked goods.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm p-3 border-0">
            <div class="fs-1 mb-2">🥛</div>
            <h3 class="fw-bold">Dairy &amp; Essentials</h3>
            <p class="text-muted">Top-quality milk, eggs, cheeses, and everyday pantry staples.</p>
        </div>
    </div>
</div>